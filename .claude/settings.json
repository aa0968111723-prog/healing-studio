{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest run:*)",
      "Bash(npm run check:*)",
      "Bash(npm test:*)",
      "Bash(ls:*)",
      "Bash(node scripts/check-deps.mjs:*)"
    ]
  }
}

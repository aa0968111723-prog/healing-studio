# ============================================================
# AI Director — 完整環境變數配置範本
# 複製此檔案為 .env 並填入真實金鑰
# ============================================================

# ── 核心平台 ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# 網站公開 URL（用於 og:url、canonical 等 SEO 標籤）
VITE_SITE_URL=https://your-domain.com

# JWT Session 簽名密鑰（請用 openssl rand -base64 32 生成）
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
# JWT Access Token 壽命（秒，預設 31536000 = 365 天）
JWT_ACCESS_TOKEN_EXPIRES_IN=31536000
# 密碼雜湊演算法（scrypt / bcrypt / argon2；預設 scrypt）
PASSWORD_HASH_ALGORITHM=scrypt

# ── Google OAuth 2.0（替換 Manus OAuth）────────────────────
# 前往 https://console.cloud.google.com/apis/credentials 建立
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/callback

# ── 資料庫 ──────────────────────────────────────────────────
# 推薦使用 Google Cloud SQL (MySQL) 或 PlanetScale
# 格式：mysql://user:password@host:3306/database
DATABASE_URL=mysql://user:password@localhost:3306/ai_director

# ── 管理員信箱（逗號分隔，登入時自動設為 admin）──────────────
ADMIN_EMAILS=aa0968111723@gmail.com

# ── Vertex AI / Gemini（Google AI Studio + Vertex AI 部署）────
# ── Google AI Studio 部署環境 ──
# 前往 https://aistudio.google.com/apikey 取得（免費額度 + 付費方案）
# 支援模型：Gemini 2.5 Pro/Flash、Imagen 3/4、Veo 2/3、Lyria 2/3、TTS
GEMINI_API_KEY=AIza...your-gemini-api-key

# ── Vertex AI 部署環境（企業級 GCP）──
# Google Cloud 服務帳號 JSON（用於 Vertex AI + Cloud Storage）
# 將 JSON 內容壓縮成單行字串貼入
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Google Cloud 專案 ID
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id

# Google Cloud 區域（Vertex AI 端點位置，預設 us-central1）
# 可選值：us-central1, us-east4, europe-west1, asia-northeast1 等
GOOGLE_CLOUD_LOCATION=us-central1

# Google Cloud Storage Bucket 名稱（替換 Manus Storage）
GCS_BUCKET_NAME=your-gcs-bucket-name

# ── LLM 引擎選擇 ─────────────────────────────────────────────
# 可設定 LLM_ENGINE 覆蓋自動偵測（auto / gemini / vertex / forge）
# auto = 自動偵測，優先 Gemini > Forge
# gemini = 強制 Google AI Studio（需 GEMINI_API_KEY）
# vertex = 強制 Vertex AI（需 GOOGLE_APPLICATION_CREDENTIALS_JSON + PROJECT_ID）
# forge = 強制 Manus Forge（向後相容）
# LLM_ENGINE=auto

# ── 以下為向後相容保留（遷移完成後可移除）──────────────────
# Manus 內建 API（遷移到 Vertex AI 後不再需要）
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=

# ── 圖片 / 影片生成 ─────────────────────────────────────────
# Fal.ai — https://fal.ai/dashboard/keys
FAL_API_KEY=your-fal-api-key

# Replicate — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your-replicate-api-token

# ── 音訊 / 語音生成 ─────────────────────────────────────────
# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Suno — AI 音樂生成
SUNO_API_KEY=your-suno-api-key

# ── 向量資料庫（RAG 記憶系統）───────────────────────────────
# Pinecone — https://app.pinecone.io
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=ai-director-memories

# ── 新聞資料來源 ────────────────────────────────────────────
# NewsAPI.org — https://newsapi.org/account
NEWS_API_KEY=your-newsapi-key

# NewsData.io — https://newsdata.io/search-dashboard
NEWSDATA_API_KEY=your-newsdata-api-key

# ── AI 監控與追蹤 ────────────────────────────────────────────
# LangSmith — https://smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=ai-director
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Brave Search API（網路搜尋 + 學習文件自動抓取）──────────
# 前往 https://brave.com/search/api/ 取得
BRAVE_SEARCH_API_KEY=your-brave-search-api-key

# ── Perplexity API（研究/搜尋）──────────────────────────────
# 前往 https://www.perplexity.ai/settings/api 取得
PERPLEXITY_API_KEY=your-perplexity-api-key

# ── PostHog 前端分析 ─────────────────────────────────────────
VITE_POSTHOG_KEY=your-posthog-project-key
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── 姿勢估測 (OpenPose / 骨骼偵測) ──────────────────────────
OPENPOSE_API_KEY=your-openpose-api-key

# ── API 用量管理告警 (/admin/api-usage) ──────────────────────
# Slack Webhook URL for API usage alerts
ALERT_SLACK_WEBHOOK=
# Email recipients for alerts (comma-separated)
ALERT_EMAIL_RECIPIENTS=
# Monthly AI budget cap in USD (default: 500)
AI_MONTHLY_BUDGET_USD=500
# PostHog server-side API key (for AI proxy event dual-write)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

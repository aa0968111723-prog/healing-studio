# ============================================================
# AI Director — 完整環境變數配置範本
# 複製此檔案為 .env 並填入真實金鑰
# ============================================================

# ── 核心平台 ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# 網站公開 URL（用於 og:url、canonical 等 SEO 標籤）
VITE_SITE_URL=https://your-domain.com

# JWT Session 簽名密鑰（請用 openssl rand -base64 32 生成）
# 別名：AUTH_SECRET 會被 self-repair 自動 rename 成 JWT_SECRET（兩個任設一個即可）
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
# JWT Access Token 壽命（秒，預設 31536000 = 365 天）
JWT_ACCESS_TOKEN_EXPIRES_IN=31536000
# 外部資料來源憑證加密金鑰（如 Notion token）。未設時回退用 JWT_SECRET。
# 建議獨立設定並用 openssl rand -base64 32 生成（>=16 字元）。
CREDENTIAL_ENCRYPTION_KEY=
# 密碼雜湊演算法（scrypt / bcrypt / argon2；預設 scrypt）
PASSWORD_HASH_ALGORITHM=scrypt

# ── 效能調節（純整數秒/數量，下游各自 parseInt 後使用）─────────
# CACHE_TTL_SECONDS：LRU 快取預設 TTL（server/_core/cache.ts），預設 300 秒
# LLM_TIMEOUT_SECONDS：所有 LLM HTTP 呼叫的 AbortSignal timeout，預設 60 秒
# MAX_CONCURRENT_LLM_CALLS：同時並行 invokeLLM 上限，超過排隊（_core/llmConcurrency.ts），預設 5
# SENSE_INTENT_TIMEOUT_SECONDS：Sense intent 推論 withTimeout 上限（server/routers/sense.ts），預設 45 秒
CACHE_TTL_SECONDS=300
LLM_TIMEOUT_SECONDS=60
MAX_CONCURRENT_LLM_CALLS=5
SENSE_INTENT_TIMEOUT_SECONDS=45

# ── Google OAuth 2.0（替換 Manus OAuth）────────────────────
# 前往 https://console.cloud.google.com/apis/credentials 建立
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/callback

# ── 資料庫 ──────────────────────────────────────────────────
# 推薦使用 Google Cloud SQL (MySQL) 或 PlanetScale
# 格式：mysql://user:password@host:3306/database
DATABASE_URL=mysql://user:password@localhost:3306/ai_director

# ── 管理員信箱（逗號分隔，登入時自動設為 admin）──────────────
ADMIN_EMAILS=aa0968111723@gmail.com

# ── OpenRouter（推薦：統一 LLM 閘道，一支金鑰打所有家）──
# 前往 https://openrouter.ai/keys 取得 API Key（需先儲值）
# 設好後，auto 路由會優先走 OpenRouter，模型 ID 用 <provider>/<model> 格式：
#   anthropic/claude-sonnet-4.6、anthropic/claude-haiku-4.5、anthropic/claude-opus-4.7、
#   google/gemini-2.5-pro、openai/gpt-4o、meta-llama/llama-3.3-70b-instruct …等
# 設定後仍可用 LLM_ENGINE=anthropic / gemini / nvidia 等強制走直連
OPENROUTER_API_KEY=sk-or-...your-openrouter-api-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # 一般不用改
# OPENROUTER_HTTP_REFERER=https://your-domain.com    # 選填：OpenRouter 後台會顯示來源
# OPENROUTER_X_TITLE=Healing Studio                   # 選填：OpenRouter 後台會顯示應用名稱

# ── Vertex AI / Gemini（Google AI Studio + Vertex AI 部署）────
# ── Anthropic Claude（光球 AI 代理人主引擎；選用，未設則自動走 OpenRouter）──
# 前往 https://console.anthropic.com/settings/keys 取得 API Key
# 注意：未設或帳戶餘額不足時，所有裸 claude-* 模型會由 inferEngineFromModelIdSafe
# 自動重寫為 OpenRouter 路徑（anthropic/claude-*），不需要直連 Anthropic 帳號。
# 預設使用 Claude Haiku 4.5（快、便宜、tool use 強），重大規劃自動 fallback
# auto 路由優先序：openrouter > anthropic > gemini > nvidia > vertex > forge
ANTHROPIC_API_KEY=sk-ant-...your-anthropic-api-key

# ── Google AI Studio 部署環境 ──
# 前往 https://aistudio.google.com/apikey 取得（免費額度 + 付費方案）
# 支援模型：Gemini 2.5 Pro/Flash、Imagen 3/4、Veo 2/3、Lyria 2/3、TTS
GEMINI_API_KEY=AIza...your-gemini-api-key

# ── Vertex AI 部署環境（企業級 GCP；選用）──
# 注意：如果不打算使用 Vertex AI（沒有 GCP 帳號或不想設定 service account），
# 直接保留空值即可。所有 vertex/* 模型 ID 會由 normalizeModelForEngine 自動
# 重寫為 OpenRouter 等效（vertex/gemini-2.5-pro → google/gemini-2.5-pro 等），
# 因此只要設定 OPENROUTER_API_KEY 就能透通使用 Gemini / Llama / Imagen。
# Google Cloud 服務帳號 JSON（用於 Vertex AI + Cloud Storage）
# 將 JSON 內容壓縮成單行字串貼入
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Google Cloud 專案 ID
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id

# Google Cloud 區域（Vertex AI 端點位置，預設 us-central1）
# 可選值：us-central1, us-east4, europe-west1, asia-northeast1 等
GOOGLE_CLOUD_LOCATION=us-central1

# Google Cloud Storage Bucket 名稱（替換 Manus Storage）
GCS_BUCKET_NAME=your-gcs-bucket-name

# ── LLM 引擎選擇 ─────────────────────────────────────────────
# 可設定 LLM_ENGINE 覆蓋自動偵測（auto / openrouter / anthropic / gemini / vertex / nvidia / forge）
# auto = 自動偵測，優先序 openrouter > anthropic > gemini > nvidia > vertex > forge
# openrouter = 強制 OpenRouter（需 OPENROUTER_API_KEY，推薦的單一入口）
# anthropic = 強制 Anthropic Claude（需 ANTHROPIC_API_KEY 直連）
# gemini = 強制 Google AI Studio（需 GEMINI_API_KEY）
# vertex = 強制 Vertex AI（需 GOOGLE_APPLICATION_CREDENTIALS_JSON + PROJECT_ID）
# nvidia = 強制 NVIDIA NIM（需 NVIDIA_API）
#          預設 MiniMax M2.7；catalog 中亦可選 Llama Nemotron Ultra 253B / Super 49B v1.5,
#          /ai-brain-settings 各推理大腦 slot 自由切換。
# forge = 強制 Manus Forge（向後相容）
# LLM_ENGINE=auto

# ── 以下為向後相容保留（遷移完成後可移除）──────────────────
# Manus 內建 API（遷移到 Vertex AI 後不再需要）
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=

# ── 地圖代理（由後端注入 Key，避免前端暴露）────────────────
FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev
FRONTEND_FORGE_API_KEY=your-forge-maps-proxy-key

# ── 圖片 / 影片生成 ─────────────────────────────────────────
# Fal.ai — https://fal.ai/dashboard/keys
FAL_API_KEY=your-fal-api-key
# Fal.ai Webhook 簽章共享密鑰（HMAC-SHA256 驗證）
# ⚠️ 必須與 FAL_API_KEY 不同；建議用 `openssl rand -hex 32` 生成
FAL_WEBHOOK_SECRET=

# Replicate — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your-replicate-api-token

# ── 音訊 / 語音生成 ─────────────────────────────────────────
# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Suno — AI 音樂生成
SUNO_API_KEY=your-suno-api-key

# ── 向量資料庫（RAG 記憶系統）───────────────────────────────
# Pinecone — https://app.pinecone.io
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=ai-director-memories

# ── 新聞資料來源 ────────────────────────────────────────────
# NewsAPI.org — https://newsapi.org/account
NEWS_API_KEY=your-newsapi-key

# NewsData.io — https://newsdata.io/search-dashboard
NEWSDATA_API_KEY=your-newsdata-api-key

# ── AI 監控與追蹤 ────────────────────────────────────────────
# LangSmith — https://smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=ai-director
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Brave Search API（網路搜尋 + 學習文件自動抓取）──────────
# 前往 https://brave.com/search/api/ 取得
# 設定後，光球 ai.chat 在使用者問「製茶過程 / how to / 流程」這類問題時
# 會自動爬網並把結果引用到回覆中。
BRAVE_SEARCH_API_KEY=your-brave-search-api-key

# 將此關掉可在不移除程式碼的情況下停用光球的爬網研究階段
ENABLE_ORB_WEB_RESEARCH=true

# ── 功能旗標（由 featureFlags.ts 的 isEnabled() 讀取）────────────────────
# 設成 false / 0 即關閉；其他值（包含空值）視為 enabled。
FEATURE_ADVANCED_SEARCH=true
FEATURE_RAG_MEMORY=false
FEATURE_RESEARCH_MODE=true

# ── Perplexity API（研究/搜尋；已淘汰直連，由 OpenRouter Sonar 取代）─────────
# 不需要再申請 Perplexity 直連金鑰：webSearch 會優先走 Brave Search，沒有結果
# 時自動走 OpenRouter perplexity/sonar 模型。如仍想用直連 API 可填入此值。
PERPLEXITY_API_KEY=

# ── GitHub 整合（AI 全站研究 → 自動建立 Issue）────────────────
# 管理員核准優化提案後，系統會在指定 repo 建立 GitHub Issue 追蹤修正。
# Token：https://github.com/settings/tokens 建立 fine-grained PAT
#         授予 Issues: Read & write（也可給 Pull requests 以開 PR）
# Repo：格式 owner/repo，例如 your-org/healing-studio
GITHUB_TOKEN=
GITHUB_REPO=

# ── PostHog 前端分析 ─────────────────────────────────────────
VITE_POSTHOG_KEY=your-posthog-project-key
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── 姿勢估測 (OpenPose / 骨骼偵測；已由 FAL.AI ControlNet 取代) ─────────
# 不需要再申請 OpenPose 直連金鑰：videoStudio.animateDiff 直接呼叫
# fal-ai/animatediff-v2v 並用 controlnet_type=openpose 參數做骨架控制；
# 圖片端用 fal-ai/flux-controlnet 也支援同樣的 openpose ControlNet。
# 此變數保留為佔位（向後相容），不會被任何服務讀取，可留空。
OPENPOSE_API_KEY=

# ── 光球代理 Orb Tool Execution（agentToolExecutor.ts）──────
# 光球代理人「呼叫外部 API 工具」的兩個必填環境變數。
# 兩者必須一起設定，缺一不可：
#   1) ORB_TOOL_REGISTRY_JSON   — 定義有哪些工具可被叫
#   2) ORB_TOOL_ALLOWED_ORIGINS — allowlist：允許連到的網域（origin）
# 若 ORB_TOOL_ALLOWED_ORIGINS 為空，所有工具呼叫一律被擋下並回
# `PRECONDITION_FAILED`（這是預期的安全預設值；正式環境必須顯式填入）。
#
# 安全建議：
#  - 只列出你「自己擁有或合約信任」的網域。
#  - origin 必須是完整 scheme://host[:port]，不接受路徑或萬用字元。
#  - 多個 origin 用半形逗號分隔，前後空白會被自動 trim。
#  - 開發階段 NODE_ENV !== "production" 時，http://localhost 與
#    http://127.0.0.1 會被自動允許（純為 DX，不影響正式環境）。
#
# Tool registry JSON schema（每筆 tool）：
#   name(必)、description(必)、method: "GET"|"POST"(必)、
#   endpoint: 完整 URL(必)、version、riskLevel: low|medium|high、
#   allowedRoles: ["admin"...]、retryPolicy: {maxRetries,backoffMs}、
#   fallbackTools: ["otherTool"...]、headers: {...}、
#   requireConfirmation: true 表示破壞性，需經使用者按下確認卡才會執行。
# 必填：正式環境請務必設定，否則所有工具呼叫都會被阻擋（PRECONDITION_FAILED）
ORB_TOOL_ALLOWED_ORIGINS=https://director.today,https://api.director.today
# 範例（複製到 .env 後請替換為自己的網域）：
# ORB_TOOL_ALLOWED_ORIGINS=https://api.your-company.com,https://crm.your-company.com
ORB_TOOL_REGISTRY_JSON=
# 範例（必須是合法 JSON，整段塞在一行）：
# ORB_TOOL_REGISTRY_JSON=[{"name":"crm.lookup","description":"查 CRM 客戶資料","method":"GET","endpoint":"https://api.your-company.com/customers"},{"name":"ticket.create","description":"建立客服工單","method":"POST","endpoint":"https://api.your-company.com/tickets","requireConfirmation":true,"riskLevel":"high"}]

# ── Orb Scheduler（自動排程任務）──────────────────────────────
# 啟動時會讀取這個 JSON 陣列並註冊 cron 排程。
# 每筆格式：
# [{"id":"daily-standup","userId":1,"cronExpression":"0 9 * * *","taskDescription":"每天早上整理今日重點","enabled":true}]
# 預設為空陣列（不啟用任何排程）。
ORB_SCHEDULER_SEED_JSON=[]

# Orb Webhook Trigger（n8n / Zapier / Make）
# 外部系統呼叫 POST /api/webhooks/orb 時要帶的共享密鑰。
ORB_WEBHOOK_SECRET=your-random-secret-here

# Gemini Live Voice
GEMINI_LIVE_API_KEY=
ORB_VOICE_MAX_SESSION_MS=600000
ORB_VOICE_MAX_CONCURRENT=3

# ── API 用量管理告警 (/admin/api-usage) ──────────────────────
# Slack Incoming Webhook URL — 每 15 分鐘 cron（apiUsageAlertJob.ts）會 POST 告警訊息
ALERT_SLACK_WEBHOOK=
# Email recipients for alerts (comma-separated) — 目前 cron 未實作 email 寄送，預留欄位
ALERT_EMAIL_RECIPIENTS=
# Monthly AI budget cap in USD (default: 500) — 用於 budget alert 比較
AI_MONTHLY_BUDGET_USD=500
# USD → NTD 匯率（default: 31.5）— Admin「成本金流」分頁把 USD 換算成新台幣顯示
# 合法範圍 1–1000，超出 / 非數字會自動退回 default。日常微調匯率不用改程式碼。
USD_TO_TWD_RATE=31.5
# PostHog server-side API key (for AI proxy event dual-write)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ── Stripe 收款 (server/routes/stripeWebhook.ts) ───────────
# 兩者皆未設定時 stripeWebhook 進入「骨架模式」：跳過簽章驗證
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── PostHog 前端追蹤（vite build time 由 vite.config.ts define 注入到 index.html）─
# 若不設定，前端 PostHog SDK 會 no-op（不發送 capture）
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── P0 4-shell restructure（feat/4-shell-restructure）────────────────────────
# 全部預設 OFF/未設＝行為與線上完全一致（zero behavior change）。
# 4-shell 路由總開關：ON 才注入 /video|/social|/learn|/settings shell + 舊路徑相容導向。
VITE_ENABLE_4SHELL=0
# /social shell（社群系統②；P5 前維持 OFF → 顯示「已關閉」佔位）
VITE_SHELL_SOCIAL=0
# /learn shell 顯示（既有 /learn 已上線；預設 ON）
VITE_SHELL_LEARN=1
# 五接縫資料來源（預設 trpc＝打既有後端＝零行為改變；改 mock 走模擬/離線）
VITE_DATA_STORE=trpc
VITE_GENERATION_PROVIDER=trpc
VITE_COMMANDER_ADAPTER=trpc
VITE_CONTEXT_PACKET_MODE=trpc
VITE_STORAGE_PROVIDER=trpc

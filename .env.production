# ============================================================================
# .env.production — 正式環境建置時旗標（Vite 在 `vite build` 自動載入）
# ----------------------------------------------------------------------------
# 這些是「建置時」注入的 public 旗標（import.meta.env.VITE_*），Vite 在
# production build 會把它們靜態替換進 bundle。Railway 走 Dockerfile（COPY . .
# → npm run build），故本檔被 copy 進 builder 後即生效，無需在 Railway 後台設定。
#
# ⚠️ 只放「可公開的功能旗標」，切勿放任何密鑰／token（本檔會進 git）。
#
# 換上 4-shell 新介面：總開關 + /social 全開；其餘富 UI 程式碼預設已 ON，
# 此處顯式列出讓維運一目了然。
#
# 回退（關掉新介面）：把 VITE_ENABLE_4SHELL 改回 0 重新 build/deploy 即還原
# 成舊版線上行為（逐字元等同），或直接刪除本檔。
# ============================================================================

# 4-shell 總開關（OFF=舊介面；ON=掛載 /video /social /learn /settings + 舊路徑相容導向）
VITE_ENABLE_4SHELL=1

# /social shell（OFF 時 /social 顯示「已關閉」佔位；ON 才是完整社群圖文殼）
VITE_SHELL_SOCIAL=1

# 以下程式碼預設已 ON，顯式宣告以利維運（如需退回 P0 行為改 0）
VITE_SHELL_LEARN=1
VITE_SHELL_LEARN_RICH=1
VITE_SHELL_SETTINGS_RICH=1
VITE_ENABLE_VIDEO_COCKPIT=1

# =============================================================================
# AIDV / healing-studio — 本機開發 .env 範本（最小可跑集）
# setup 腳本會把本檔複製成 <repo>/.env，並自動產生 JWT_SECRET。
# 完整變數清單見 repo 內 .env.example（16KB，所有可選金鑰都在那）。
#
# 規則（master-plan 鐵律 3）：任何「正式」金鑰一律只貼 Railway，
#   絕不 commit。本檔僅供本機 dev；.env 已在 .gitignore。
# =============================================================================

# ── 🔴 必填（沒有就無法啟動 / DB 功能） ─────────────────────────────────
NODE_ENV=development
PORT=3000
# 由 setup 腳本以 `openssl rand -base64 32` 自動覆寫此行（別名 AUTH_SECRET 亦可）
JWT_SECRET=__GENERATED_BY_SETUP__
# 對應 docker-compose.yml 的本機 MySQL
DATABASE_URL=mysql://hs:hs_dev_pw@127.0.0.1:3306/healing_studio

# ── 本機站點 ────────────────────────────────────────────────────────────
VITE_SITE_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# ── 🟦 前端旗標：打開新「四殼一脊椎」導演台 UI（dev 想看到新介面就全開）──
# 線上開啟政策（2026-06-16）：新任務預設 ON。dev 直接全開最貼近線上。
VITE_ENABLE_4SHELL=1
VITE_ENABLE_AIDV_CHROME=1
VITE_ENABLE_DIRECTOR_CONSOLE=1
VITE_ENABLE_PROJECT_SSOT=1
VITE_ENABLE_PROJECT_HUB=1
VITE_ENABLE_VIDEO_COCKPIT=1
VITE_ENABLE_VIDEO_GATE_KIT=1
VITE_ENABLE_PROMPT_VAULT=1
VITE_ENABLE_WORLD_STYLE_INJECTION=1

# ── 🟨 Redis（AIDV-13/20 先備；現行碼尚未讀取，留著無害）─────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── 🟩 LLM（選填：留空＝OARS 友善警告、不崩潰；要真生成再貼）────────────
# 最省事：一支 OpenRouter 打所有家（auto 路由優先走它）
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_ENGINE=auto

# ── 🟩 多模態生成（缺對應金鑰＝該模組無法實跑，但不崩潰）──────────────────
FAL_API_KEY=
FAL_WEBHOOK_SECRET=
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=
SUNO_API_KEY=

# ── 🟩 RAG 記憶（現行 Pinecone；AIDV-19 後改 Supabase pgvector）───────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=ai-director-memories

# ── 🟩 Google 登入（dev 可先不接；不接就只用 local-auth）──────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/callback

# ── 管理員（填你的 email；登入後自動升 admin）────────────────────────────
ADMIN_EMAILS=you@example.com
